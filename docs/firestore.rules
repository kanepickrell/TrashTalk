rules_version = '2';

// TrashTalk Firestore rules.
//
// The guiding principle: the neighbourhood's state is public knowledge — the
// whole project exists to publish it — while anything attributed to a person
// may only be written by that person.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Profiles: readable by anyone signed in, because leaderboards are the
    // point. Owners may edit who they are; they may not edit what they have
    // earned.
    //
    // Before this, an owner could write totalPoints directly, which made the
    // leaderboard a list of claims rather than results. Those fields are now
    // written only by the scoring function through the Admin SDK, which these
    // rules do not apply to.
    // A denylist, not an allowlist. The client owns a lot of its profile --
    // narrative progress, chosen path, badge tiers, the stats it derives for
    // its own screens -- and enumerating all of that would mean this rule
    // breaks every time a field is added, which is how rules end up loosened
    // in a hurry by somebody debugging a denial.
    //
    // These three are the ones that decide anything:
    //
    //   totalPoints, weeklyPoints  what the leaderboard ranks on
    //   streakDays                 feeds the scoring multiplier, so a client
    //                              that could set it could inflate every
    //                              future award by up to 1.6x
    //
    // They are written only by the scoring function through the Admin SDK,
    // which these rules do not apply to.
    function serverOwnedProfileFields() {
      return ['totalPoints', 'weeklyPoints', 'streakDays'];
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid)
                    && !request.resource.data.keys().hasAny(serverOwnedProfileFields());
      allow update: if isOwner(uid)
                    && !request.resource.data.diff(resource.data)
                         .affectedKeys().hasAny(serverOwnedProfileFields());
      allow delete: if false;
    }

    // Observations are the dataset. They are written by the scoring function
    // and nobody else: a client that could write one could write its own
    // points into it, which is what it used to do.
    match /collections/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    // What a client actually submits: a description of what it did. The
    // server decides what that was worth.
    //
    // Write-once, because a submission that can be edited after the function
    // has read it is a submission that can be scored twice with different
    // contents.
    match /submissions/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.segments is list
                    && request.resource.data.segments.size() > 0
                    && request.resource.data.segments.size() <= 100;
      allow update, delete: if false;
    }

    // The server's answer. Read it, never write it.
    match /results/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Per-user contest standing, maintained by the function.
    match /segment_contest/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Flags: same attribution rule. The planter may delete their own.
    match /flags/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn()
                    && resource.data.userId == request.auth.uid;
    }

    // Territory and density: server-write only.
    //
    // This was open to any signed-in client, which meant the contest model and
    // the anti-cheat checks were advisory -- a modified client could simply
    // write itself the ownership it wanted. Ownership is now decided in one
    // transaction by the scoring function, which runs under the Admin SDK and
    // is not subject to these rules.
    match /segment_state/{segmentId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Crews are curated rather than user-created, but requiring a human to
    // hand-create four documents before the app works is a bad first run. So
    // creation is allowed for exactly the four known crew ids and nothing else:
    // the client can seed the roster it ships with, and cannot invent crews.
    function isKnownCrew(teamId) {
      return teamId in ['team_trashers', 'team_austin', 'team_wilshire', 'team_night'];
    }

    match /teams/{teamId} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && isKnownCrew(teamId)
                    && request.resource.data.name is string
                    && request.resource.data.cityId is string;
      // Membership is the client's to change; the crew's score is not.
      allow update: if signedIn()
                    && request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly(['memberCount']);
      allow delete: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
