rules_version = '2';

// TrashTalk Firestore rules.
//
// The guiding principle: the neighbourhood's state is public knowledge — the
// whole project exists to publish it — while anything attributed to a person
// may only be written by that person.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Profiles: readable by anyone signed in, because leaderboards are the
    // point. Writable only by their owner.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid);
      allow delete: if false;
    }

    // Pickups are an append-only log. A new document must be attributed to the
    // caller, so nobody can log a collection as somebody else, and existing
    // records are immutable: the dataset's value depends on observations not
    // being quietly rewritten after the fact.
    match /collections/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll(['userId', 'segmentId', 'createdAt'])
                    && request.resource.data.points is number
                    && request.resource.data.points >= 0
                    && request.resource.data.points <= 100000;
      allow update, delete: if false;
    }

    // Flags: same attribution rule. The planter may delete their own.
    match /flags/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn()
                    && resource.data.userId == request.auth.uid;
    }

    // Shared survey state. Any signed-in user may update a segment, because
    // that is what a shared survey is: the next person to walk a block gets to
    // correct the record. The guard against vandalism is social and
    // statistical rather than a rule — every write is attributable through the
    // collections log, and repeated surveys converge.
    //
    // The index stays in range and the guardian field, if set, must name the
    // caller: you cannot adopt a segment on somebody else's behalf.
    match /segment_state/{segmentId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
                            && (!('litterIndex' in request.resource.data)
                                || (request.resource.data.litterIndex is number
                                    && request.resource.data.litterIndex >= 0
                                    && request.resource.data.litterIndex <= 1))
                            && (!('guardianUserId' in request.resource.data)
                                || request.resource.data.guardianUserId == null
                                || request.resource.data.guardianUserId == request.auth.uid
                                || resource == null
                                || resource.data.guardianUserId == request.auth.uid);
      allow delete: if false;
    }

    // Crews are curated, not user-created: membership counts are maintained by
    // the client, but the roster itself is seeded from the console.
    match /teams/{teamId} {
      allow read: if signedIn();
      allow update: if signedIn()
                    && request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly(['memberCount', 'weeklyPoints', 'totalPieces', 'totalPoints']);
      allow create, delete: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
